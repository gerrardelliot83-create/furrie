# =============================================================================
# Furrie Environment Variables
# Copy this file to .env.local and fill in the values
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...   # Also known as ANON key
SUPABASE_SECRET_KEY=eyJ...                     # Service role key (server-side only)

# --- Daily.co (Video Consultations) ---
DAILY_API_KEY=your-daily-api-key
DAILY_WEBHOOK_SECRET=your-daily-webhook-secret
NEXT_PUBLIC_DAILY_DOMAIN=your-domain.daily.co

# --- Resend (Email) ---
RESEND_API_KEY=re_...

# --- Sentry (Error Monitoring) ---
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=furrie
SENTRY_AUTH_TOKEN=sntrys_...
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# --- UploadThing (File Uploads) ---
UPLOADTHING_TOKEN=your-uploadthing-token

# --- Cron Job Authentication ---
# Set this in Vercel. Cron jobs authenticate with Bearer <CRON_SECRET>.
# If not set, cron auth is skipped (for local development).
CRON_SECRET=your-random-secret

# --- Application ---
NEXT_PUBLIC_APP_URL=https://app.furrie.in

# --- Payments (Deferred — not required for soft launch) ---
# Set NEXT_PUBLIC_SKIP_PAYMENTS=true to bypass payment processing.
NEXT_PUBLIC_SKIP_PAYMENTS=true
# NEXT_PUBLIC_CASHFREE_ENV=sandbox
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# --- Expo Push (Mobile) ---
# OPTIONAL: When set, push send requests to Expo include this token as a
# Bearer header so only authorised callers can deliver to Furrie's push tokens.
# Generate at https://expo.dev/accounts/<account>/settings/access-tokens
# Leave unset for unauthenticated push (Expo default; works for v1).
# EXPO_ACCESS_TOKEN=
